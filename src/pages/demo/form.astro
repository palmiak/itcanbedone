---
import Base from '../../layouts/Base.astro';
---
<Base title="Form + bots demo | Looks Done. Is Done." description="A contact form with browser validation and a honeypot, wired to Netlify Forms. Submit it empty, then play the bot." ogPath="form">
  <header class="top"><div class="bar"><div class="wrap"><a class="logo" href="/">Looks Done. Is Done. <span class="mini-stamp">Passed</span></a><a class="by" href="/#checklist">← back to the checklist</a></div></div></header>
  <main class="wrap demo">
    <h1 class="display">Forms, then bots.</h1>
    <div class="prose">
      <p>
        Submit it empty and the browser stops you. Then press <strong>Play the bot</strong>: it fills the hidden
        trap field a human never sees, and the submission is dropped. Real submissions are posted to
        Netlify Forms and emailed to the site owner; the bot's is discarded.
      </p>
    </div>

    <div class="demo-grid">
      <form id="demo-form" class="form" name="contact" action="/demo/form" method="POST" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="contact" />
        <label>Name <input name="name" required autocomplete="name" /></label>
        <label>Email <input name="email" type="email" required autocomplete="email" /></label>
        <label>Message <textarea name="message" rows="4" required minlength="10"></textarea></label>
        <label class="trap" aria-hidden="true">Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        <div class="actions">
          <button class="btn" type="submit">Send</button>
          <button class="btn plain" type="button" id="bot">Play the bot</button>
        </div>
      </form>

      <div>
        <div class="log" aria-live="polite" id="form-log">
          <div class="head">$ tail -f submissions</div>
          <div class="row"><span>waiting for input…</span><span></span></div>
        </div>
        <h2 class="gap">In production, on Netlify</h2>
<pre class="term">&lt;form name="contact" method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"&gt;</pre>
        <p class="small gap">Netlify also runs every submission through Akismet. Vercel and Cloudflare offer BotID and Turnstile for the same job; both need a small function to receive the form.</p>
      </div>
    </div>
  </main>
  <script src="../../scripts/form-demo.ts"></script>
</Base>
